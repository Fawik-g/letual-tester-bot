# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID админов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=123456789

# Путь к файлу базы данных SQLite
DB_PATH=letual.db

# Время ежедневного напоминания сотрудникам про обход (местное время, ЧЧ:ММ)
REMINDER_TIME=10:00

# Прокси, если api.telegram.org заблокирован провайдером (оставьте пустым, если связь прямая)
# Форматы: http://127.0.0.1:7890 | socks5://127.0.0.1:10808 | socks5://user:pass@host:port
PROXY_URL=
